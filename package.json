{
  "name": "@hibira-io/refine",
  "version": "0.1.0",
  "description": "Refine liveProvider for Hibira and other Pusher-compatible servers: live lists, records and notifications in Refine admin panels over pusher-js, plus a server helper to publish live events",
  "keywords": [
    "refine",
    "refinedev",
    "live-provider",
    "liveprovider",
    "realtime",
    "admin-panel",
    "pusher",
    "pusher-js",
    "websocket",
    "hibira"
  ],
  "homepage": "https://hibira.io",
  "bugs": {
    "url": "https://github.com/hibira-io/refine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hibira-io/refine.git"
  },
  "license": "MIT",
  "author": "Hibira (https://hibira.io)",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./server": {
      "types": "./server.d.ts",
      "default": "./server.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "server.js",
    "server.d.ts",
    "channel.js",
    "channel.d.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:e2e": "node --test test/e2e/*.e2e.mjs",
    "typecheck": "tsc -p test/tsconfig.json"
  },
  "peerDependencies": {
    "@refinedev/core": ">=4",
    "pusher-js": ">=7"
  },
  "peerDependenciesMeta": {
    "@refinedev/core": {
      "optional": true
    },
    "pusher-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@refinedev/core": "^5.0.12",
    "pusher": "^5.3.4",
    "pusher-js": "^8.6.0",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
